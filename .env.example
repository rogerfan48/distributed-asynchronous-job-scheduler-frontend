# ─────────────────────────────────────────────────────────────────────────────
# Job Scheduler frontend — environment configuration
# Copy to `.env` (or `.env.local` for dev) and fill in. NEVER commit a real .env.
# All values below are SERVER-ONLY. Do not add NEXT_PUBLIC_* secrets here:
# anything prefixed NEXT_PUBLIC_ is inlined into the browser bundle.
# ─────────────────────────────────────────────────────────────────────────────

# Origin of the backend Job Scheduler API (the "other server"), reached over
# WireGuard. The BFF (Next.js Route Handlers + Server Components) calls this
# server-side; the browser never sees it. Scheme + host (+ port if non-standard),
# NO trailing slash, NO /api/v1 suffix.  
#
# Production: set this to the backend's WireGuard address (do not commit the real
# value — keep it only in your local .env). Local dev example below.
BACKEND_ORIGIN=http://127.0.0.1:8000

# Optional. Public site URL, used only to build absolute Open Graph / canonical
# links for SEO and social share cards (not a secret). Defaults to the production
# domain in code; set this if you deploy under a different domain.
# SITE_URL=https://your-domain.example

# Optional registration gate (server-only). When set, the registration form's
# 「註冊碼」 must match this value, enforced by the BFF before calling the backend.
# Leave unset to keep registration open. Never use NEXT_PUBLIC_ for this.
# REGISTER_PASSCODE=change-me

# /monitoring embeds Grafana via a same-origin sub-path reverse-proxied over
# WireGuard (host nginx: location /grafana/ -> Grafana). Grafana must be served
# under that sub-path (serve_from_sub_path=true, root_url=.../grafana/) and the
# dashboard must be public (or anonymous) to be iframable.
#
# Browser-facing dashboard URL — a RELATIVE same-origin path (not localhost/IP):
# GRAFANA_DASHBOARD_URL=/grafana/public-dashboards/<public-dashboard-id>
#
# Server-only Grafana origin for the health check (reached over WireGuard):
# GRAFANA_ORIGIN=http://<grafana-wireguard-host>:8787
# Optional explicit health URL (defaults to ${GRAFANA_ORIGIN}/grafana/api/health):
# GRAFANA_HEALTH_URL=http://<grafana-wireguard-host>:8787/grafana/api/health
